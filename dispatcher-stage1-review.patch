+@{
+    # Шлях до локального клону репозиторію LyServer
+    RepoPath       = 'C:\Users\Admin\Documents\LyServer'
+
+    # GitHub repo у форматі owner/name
+    GitHubRepo     = 'shatVM/LyServer'
+
+    # Очікуваний origin remote (суворий захист від роботи не в тому репозиторії)
+    ExpectedRemote = 'https://github.com/shatVM/LyServer.git'
+
+    # Модель OpenCode для виконання задач
+    Model          = 'opencode/mimo-v2.6-flash-free'
+
+    # Тайм-аути (секунди)
+    ModelPingTimeoutSec = 120
+    TaskTimeoutSec      = 1800
+
+    # Мітки GitHub
+    LabelReady      = 'ready-for-opencode'
+    LabelInProgress = 'in-progress'
+    LabelReview     = 'opencode-review'
+
+    # Каталог журналів (поза репозиторієм!)
+    LogDir         = 'C:\Users\Admin\Documents\LyServerDispatcherLogs'
+
+    # Каталог журналів виконання задач (діагностика, робочі копії)
+    RunRootDir     = 'C:\Users\Admin\Documents\LyServerDispatcherRuns'
+
+    # Захист від паралельного запуску: каталог lock-файлів
+    LockDir        = 'C:\Users\Admin\Documents\LyServerDispatcherLogs\locks'
+}
diff --git a/tools/dispatcher/dispatcher.ps1 b/tools/dispatcher/dispatcher.ps1
new file mode 100644
index 0000000..bcf9b43
--- /dev/null
+++ b/tools/dispatcher/dispatcher.ps1
@@ -0,0 +1,476 @@
+﻿#requires -Version 5.1
+<#
+.SYNOPSIS
+    LyServer dispatcher v0.2 - stage 1: preflight checks and preview mode.
+.DESCRIPTION
+    Stage 1 performs read-only checks and shows a preview of pending tasks.
+    It does not change GitHub state, branches, or repository files.
+    Side effects are limited to: creating/writing log files in LogDir
+    (validated to be OUTSIDE the repository) and running `opencode run`
+    as a model ping. Later stages (locks, worktrees, task execution,
+    publishing) are intentionally NOT implemented yet.
+.NOTES
+    PowerShell 5.1 compatible. No secrets are stored or logged.
+#>
+[CmdletBinding()]
+param(
+    # Default resolved below: in PS 5.1 $PSScriptRoot is empty during param binding
+    [string]$ConfigPath,
+    # Diagnostics only: skip the model ping. The preview then reports
+    # "MODEL NOT VERIFIED"; do not use for real runs.
+    [switch]$SkipModelPing
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+if ([string]::IsNullOrEmpty($ConfigPath)) {
+    $ConfigPath = Join-Path -Path $PSScriptRoot -ChildPath 'config.psd1'
+}
+
+# ---------------------------------------------------------------------------
+# Logging (outside the repository, never contains secrets)
+# ---------------------------------------------------------------------------
+$script:LogFile = $null
+
+function Write-Log {
+    param([string]$Level, [string]$Message)
+    $line = '{0} [{1}] {2}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Level, $Message
+    switch ($Level) {
+        'ERROR' { Write-Host $line -ForegroundColor Red }
+        'WARN'  { Write-Host $line -ForegroundColor Yellow }
+        'OK'    { Write-Host $line -ForegroundColor Green }
+        default { Write-Host $line }
+    }
+    if ($script:LogFile) {
+        try { Add-Content -LiteralPath $script:LogFile -Value $line -Encoding UTF8 }
+        catch { Write-Host ("(log write failed: {0})" -f $_.Exception.Message) -ForegroundColor Yellow }
+    }
+}
+
+function Stop-Dispatcher {
+    param([string]$Message)
+    Write-Log 'ERROR' $Message
+    Write-Log 'INFO' 'Dispatcher stopped. No GitHub or repository state was modified.'
+    exit 1
+}
+
+# ---------------------------------------------------------------------------
+# Windows command-line argument escaping (CommandLineToArgvW rules):
+#   - empty arguments are emitted as "" so they survive argument parsing;
+#   - backslashes are literal unless followed by a double quote;
+#   - a run of backslashes before a double quote is doubled, the quote is
+#     escaped with a backslash;
+#   - trailing backslashes inside a quoted argument are doubled.
+#   - arguments containing cmd.exe metacharacters (& | < > ^ ( )) are quoted
+#     as well: .cmd wrappers are launched via `cmd /d /c`, where
+#     CommandLineToArgvW rules alone do NOT protect against shell parsing.
+#     Known limitation: % expansion inside .cmd files is not prevented by
+#     quoting; .cmd wrappers must not forward such arguments unchecked.
+# ---------------------------------------------------------------------------
+function ConvertTo-WinArg {
+    param([string]$Value)
+    if ([string]::IsNullOrEmpty($Value)) { return '""' }
+    if ($Value -notmatch '[\s"&|<>^()]') { return $Value }
+    $sb = New-Object System.Text.StringBuilder
+    [void]$sb.Append('"')
+    $pendingBackslashes = 0
+    foreach ($ch in $Value.ToCharArray()) {
+        if ($ch -eq '\') { $pendingBackslashes++; continue }
+        if ($ch -eq '"') {
+            [void]$sb.Append(('\' * ($pendingBackslashes * 2 + 1)))
+            [void]$sb.Append('"')
+        }
+        else {
+            if ($pendingBackslashes -gt 0) { [void]$sb.Append(('\' * $pendingBackslashes)) }
+            [void]$sb.Append($ch)
+        }
+        $pendingBackslashes = 0
+    }
+    [void]$sb.Append(('\' * ($pendingBackslashes * 2)))
+    [void]$sb.Append('"')
+    return $sb.ToString()
+}
+
+# Quoting for cmd.exe wrappers (.cmd/.bat via `cmd /d /c`).
+# cmd.exe does NOT understand CommandLineToArgvW backslash escaping, and it
+# applies its own quote-stripping heuristic to the /c command line. The only
+# reliable form is: cmd /d /c ""script" "arg1" "arg2"" (double-wrapped), with
+# every argument in plain double quotes.
+# Refused loudly instead of being silently corrupted:
+#   - an embedded double quote: cmd.exe has NO escaping for `"` at all;
+#   - a trailing backslash: cmd passes it literally, but the FINAL receiver
+#     (node/powershell via CommandLineToArgvW) decodes \" as a literal quote,
+#     merging neighbouring arguments. Fidelity across both layers is
+#     impossible, so such arguments are rejected with a clear message.
+function ConvertTo-WinCmdArg {
+    param([string]$Value)
+    if ($Value -match '"') {
+        throw "cmd.exe wrappers cannot receive arguments containing a double quote: '$Value'"
+    }
+    if ($Value.EndsWith('\')) {
+        throw "cmd.exe wrappers cannot receive arguments ending with a backslash (would corrupt argument parsing downstream): '$Value'"
+    }
+    if ([string]::IsNullOrEmpty($Value)) { return '""' }
+    return '"' + $Value + '"'
+}
+
+# ---------------------------------------------------------------------------
+# Command resolution: PATH entries may be shims (.ps1/.cmd from npm) which
+# System.Diagnostics.Process cannot start directly; wrap them in a shell.
+# Returns @{ FilePath = <exe>; PrefixArgs = <args inserted before ours> }
+# ---------------------------------------------------------------------------
+function Resolve-Command {
+    param([Parameter(Mandatory)][string]$Name)
+    # Supported types are requested EXPLICITLY:
+    #   Application    - real executables (.exe);
+    #   ExternalScript - .ps1 shims (e.g. npm's opencode.ps1). A plain
+    #                    -CommandType Application would exclude them and
+    #                    make the .ps1 branch below unreachable.
+    $candidates = @(Get-Command $Name -All -ErrorAction SilentlyContinue |
+        Where-Object { $_.CommandType -eq 'Application' -or $_.CommandType -eq 'ExternalScript' })
+    if ($candidates.Count -eq 0) { return $null }
+    # Take the first resolution result only (PATH order)
+    $src = $candidates[0].Source
+    switch -Regex ($src) {
+        '\.ps1$' {
+            return @{ FilePath = 'powershell.exe'; PrefixArgs = @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', $src) }
+        }
+        '\.(cmd|bat)$' {
+            # /d disables registry AutoRun scripts for this cmd.exe instance.
+            # UseCmdQuoting: arguments must be quoted with cmd.exe rules
+            # (double-wrapped command line), not CommandLineToArgvW rules.
+            return @{ FilePath = 'cmd.exe'; PrefixArgs = @('/d', '/c', $src); UseCmdQuoting = $true }
+        }
+        default {
+            return @{ FilePath = $src; PrefixArgs = @() }
+        }
+    }
+}
+
+function Invoke-Native {
+    param(
+        [Parameter(Mandatory)][string]$Tool,
+        [string[]]$ArgumentList = @(),
+        [int]$TimeoutSec = 0
+    )
+    $resolved = Resolve-Command -Name $Tool
+    if (-not $resolved) { throw "Cannot resolve tool: $Tool" }
+    $allArgs = @($resolved.PrefixArgs) + @($ArgumentList)
+
+    $psi = New-Object System.Diagnostics.ProcessStartInfo
+    $psi.FileName = $resolved.FilePath
+    if ($resolved.ContainsKey('UseCmdQuoting')) {
+        # cmd.exe wrapper: build /d /c ""script" "arg1" "arg2"" - see
+        # ConvertTo-WinCmdArg for why CommandLineToArgvW quoting fails here.
+        $core = @($allArgs | Select-Object -Skip 2)   # skip the fixed /d /c
+        $quoted = ($core | ForEach-Object { ConvertTo-WinCmdArg $_ }) -join ' '
+        $psi.Arguments = '/d /c "' + $quoted + '"'
+    }
+    else {
+        $psi.Arguments = ($allArgs | ForEach-Object { ConvertTo-WinArg $_ }) -join ' '
+    }
+    $psi.RedirectStandardOutput = $true
+    $psi.RedirectStandardError = $true
+    $psi.UseShellExecute = $false
+    $psi.CreateNoWindow = $true
+
+    $proc = New-Object System.Diagnostics.Process
+    $proc.StartInfo = $psi
+    [void]$proc.Start()
+
+    # Async read avoids deadlock on large output
+    $stdoutTask = $proc.StandardOutput.ReadToEndAsync()
+    $stderrTask = $proc.StandardError.ReadToEndAsync()
+
+    if ($TimeoutSec -gt 0) {
+        if (-not $proc.WaitForExit($TimeoutSec * 1000)) {
+            # Kill the whole process TREE: Process.Kill() alone leaves
+            # grandchildren (e.g. node behind the opencode shim) alive.
+            $prevEap = $ErrorActionPreference
+            $ErrorActionPreference = 'Continue'
+            try { & taskkill.exe /PID $proc.Id /T /F 2>&1 | Out-Null } catch { }
+            $ErrorActionPreference = $prevEap
+            try { if (-not $proc.HasExited) { $proc.Kill() } } catch { }
+            return [pscustomobject]@{ ExitCode = $null; StdOut = $stdoutTask.Result; StdErr = $stderrTask.Result; TimedOut = $true }
+        }
+    }
+    else {
+        $proc.WaitForExit()
+    }
+
+    return [pscustomobject]@{ ExitCode = $proc.ExitCode; StdOut = $stdoutTask.Result; StdErr = $stderrTask.Result; TimedOut = $false }
+}
+
+# ---------------------------------------------------------------------------
+# Model answer check: strip ANSI sequences, normalize lines, require the
+# FINAL non-empty line to be exactly "PONG" (case-sensitive). "NOT PONG",
+# "pong" or a multi-line blob containing PONG somewhere are rejected.
+# ---------------------------------------------------------------------------
+function Test-PongResponse {
+    param([string]$Output)
+    if ([string]::IsNullOrEmpty($Output)) { return $false }
+    $clean = [regex]::Replace($Output, "\x1B\[[0-9;]*[A-Za-z]", '')
+    $lines = @($clean -split "`r?`n" | ForEach-Object { $_.Trim() } | Where-Object { $_ })
+    if ($lines.Count -eq 0) { return $false }
+    return ($lines[-1] -ceq 'PONG')
+}
+
+function Test-PathInside {
+    # Is $Child the same as, or nested inside, $Parent?
+    param([string]$Child, [string]$Parent)
+    $c = [IO.Path]::GetFullPath($Child).TrimEnd('\') + '\'
+    $p = [IO.Path]::GetFullPath($Parent).TrimEnd('\') + '\'
+    return $c.StartsWith($p, [StringComparison]::OrdinalIgnoreCase)
+}
+
+# ---------------------------------------------------------------------------
+# Configuration: load and validate BEFORE any process is started
+# ---------------------------------------------------------------------------
+Write-Host ''
+Write-Host 'LyServer dispatcher v0.2 (stage 1: checks + preview)' -ForegroundColor Cyan
+Write-Host 'Mode: no changes to GitHub, branches, or repository files.' -ForegroundColor Cyan
+Write-Host 'Side effects: log files in LogDir; `opencode run` model ping.' -ForegroundColor Cyan
+Write-Host ''
+
+if (-not (Test-Path -LiteralPath $ConfigPath -PathType Leaf)) {
+    Write-Host "STOP: config not found: $ConfigPath" -ForegroundColor Red
+    Write-Host "Copy config.example.psd1 to config.psd1 and adjust it." -ForegroundColor Yellow
+    exit 1
+}
+
+try {
+    $cfg = Import-PowerShellDataFile -Path $ConfigPath
+}
+catch {
+    Write-Host "STOP: cannot parse config: $($_.Exception.Message)" -ForegroundColor Red
+    exit 1
+}
+
+# --- validation: required keys, types, ranges, path placement -------------
+$validationErrors = @()
+$requiredStringKeys = @(
+    'RepoPath', 'GitHubRepo', 'ExpectedRemote', 'Model',
+    'LabelReady', 'LabelInProgress', 'LabelReview',
+    'LogDir', 'RunRootDir', 'LockDir'
+)
+foreach ($key in $requiredStringKeys) {
+    if (-not $cfg.ContainsKey($key) -or [string]::IsNullOrWhiteSpace([string]$cfg[$key])) {
+        $validationErrors += "missing or empty required key: $key"
+    }
+}
+foreach ($key in @('ModelPingTimeoutSec', 'TaskTimeoutSec')) {
+    if (-not $cfg.ContainsKey($key)) {
+        $validationErrors += "missing required key: $key"
+        continue
+    }
+    $parsed = 0
+    if (-not [int]::TryParse([string]$cfg[$key], [ref]$parsed) -or $parsed -le 0) {
+        $validationErrors += "must be a positive integer: $key = '$($cfg[$key])'"
+    }
+}
+if ($validationErrors.Count -eq 0) {
+    if ($cfg.GitHubRepo -notmatch '^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$') {
+        $validationErrors += "GitHubRepo must be 'owner/name': '$($cfg.GitHubRepo)'"
+    }
+    foreach ($key in @('RepoPath', 'LogDir', 'RunRootDir', 'LockDir')) {
+        if (-not [IO.Path]::IsPathRooted([string]$cfg[$key])) {
+            $validationErrors += "path must be absolute: $key = '$($cfg[$key])'"
+        }
+    }
+    if ($validationErrors.Count -eq 0) {
+        # Log/run/lock directories must never live inside the clone:
+        # a log file there would make the tree dirty and self-sabotage.
+        foreach ($key in @('LogDir', 'RunRootDir', 'LockDir')) {
+            if (Test-PathInside -Child ([string]$cfg[$key]) -Parent ([string]$cfg.RepoPath)) {
+                $validationErrors += "$key must be OUTSIDE the repository ($($cfg.RepoPath)): '$($cfg[$key])'"
+            }
+        }
+    }
+}
+if ($validationErrors.Count -gt 0) {
+    Write-Host 'STOP: invalid configuration:' -ForegroundColor Red
+    $validationErrors | ForEach-Object { Write-Host ("  - {0}" -f $_) -ForegroundColor Red }
+    exit 1
+}
+
+# --- log directory: create and verify writability BEFORE anything else ----
+try {
+    if (-not (Test-Path -LiteralPath $cfg.LogDir -PathType Container)) {
+        New-Item -ItemType Directory -Path $cfg.LogDir -Force | Out-Null
+    }
+    $script:LogFile = Join-Path $cfg.LogDir ('dispatcher-{0}.log' -f (Get-Date -Format 'yyyyMMdd-HHmmss'))
+    Set-Content -LiteralPath $script:LogFile -Value '' -Encoding UTF8 -ErrorAction Stop
+}
+catch {
+    Write-Host ("STOP: cannot write logs to '{0}': {1}" -f $cfg.LogDir, $_.Exception.Message) -ForegroundColor Red
+    exit 1
+}
+
+Write-Log 'INFO' '=== Dispatcher started (stage 1: checks + preview) ==='
+Write-Log 'INFO' ("Config: {0}" -f $ConfigPath)
+Write-Log 'INFO' ("RepoPath: {0}" -f $cfg.RepoPath)
+Write-Log 'INFO' ("GitHubRepo: {0}" -f $cfg.GitHubRepo)
+Write-Log 'INFO' ("Model: {0}" -f $cfg.Model)
+Write-Log 'INFO' ("PowerShell: {0}" -f $PSVersionTable.PSVersion)
+
+# ---------------------------------------------------------------------------
+# Preflight 1: required tools
+# ---------------------------------------------------------------------------
+foreach ($toolName in @('git', 'gh', 'opencode')) {
+    $resolvedTool = Resolve-Command -Name $toolName
+    if (-not $resolvedTool) { Stop-Dispatcher ("Required tool not found in PATH: {0}" -f $toolName) }
+    Write-Log 'OK' ("Tool available: {0} -> {1}" -f $toolName, $resolvedTool.FilePath)
+}
+
+# ---------------------------------------------------------------------------
+# Preflight 2: GitHub CLI authentication
+# ---------------------------------------------------------------------------
+$auth = Invoke-Native -Tool 'gh' -ArgumentList @('auth', 'status')
+if ($auth.ExitCode -ne 0) { Stop-Dispatcher ('gh is not authenticated. Exit code: {0}' -f $auth.ExitCode) }
+Write-Log 'OK' 'gh: authenticated'
+
+# ---------------------------------------------------------------------------
+# Preflight 3: local repository path, remote, work tree
+# ---------------------------------------------------------------------------
+if (-not (Test-Path -LiteralPath $cfg.RepoPath -PathType Container)) {
+    Stop-Dispatcher ("Repository directory does not exist: {0}" -f $cfg.RepoPath)
+}
+
+$wt = Invoke-Native -Tool 'git' -ArgumentList @('-C', $cfg.RepoPath, 'rev-parse', '--is-inside-work-tree')
+if ($wt.ExitCode -ne 0 -or $wt.StdOut.Trim() -ne 'true') {
+    Stop-Dispatcher ("Not a git working tree: {0}" -f $cfg.RepoPath)
+}
+Write-Log 'OK' 'git: directory is a working tree'
+
+$remote = Invoke-Native -Tool 'git' -ArgumentList @('-C', $cfg.RepoPath, 'remote', 'get-url', 'origin')
+if ($remote.ExitCode -ne 0) { Stop-Dispatcher 'Cannot read origin remote.' }
+$foundRemote = $remote.StdOut.Trim().TrimEnd('/')
+$expectedRemote = $cfg.ExpectedRemote.TrimEnd('/')
+if ($foundRemote -ne $expectedRemote) {
+    Stop-Dispatcher ("origin mismatch. Found: {0}, expected: {1}" -f $foundRemote, $expectedRemote)
+}
+Write-Log 'OK' ("git: origin matches expected remote ({0})" -f $foundRemote)
+
+# ---------------------------------------------------------------------------
+# Preflight 4: GitHub API reachability + default branch
+#    gh api performs GET by default (read-only) for this endpoint.
+# ---------------------------------------------------------------------------
+$repoApi = Invoke-Native -Tool 'gh' -ArgumentList @('api', ("repos/{0}" -f $cfg.GitHubRepo), '--jq', '.default_branch')
+if ($repoApi.ExitCode -ne 0) {
+    Stop-Dispatcher ('GitHub API is unreachable for {0}. StdErr: {1}' -f $cfg.GitHubRepo, $repoApi.StdErr.Trim())
+}
+$defaultBranch = $repoApi.StdOut.Trim()
+if ([string]::IsNullOrWhiteSpace($defaultBranch)) { Stop-Dispatcher 'GitHub returned an empty default branch.' }
+Write-Log 'OK' ("GitHub API reachable; default branch: {0}" -f $defaultBranch)
+
+# ---------------------------------------------------------------------------
+# Preflight 5: clean working tree of the MAIN clone.
+#    MUST run before the model ping: the ping launches an external agent,
+#    which must never start against a dirty tree.
+# ---------------------------------------------------------------------------
+$status = Invoke-Native -Tool 'git' -ArgumentList @('-C', $cfg.RepoPath, 'status', '--porcelain')
+if ($status.ExitCode -ne 0) { Stop-Dispatcher 'Cannot read working tree status.' }
+if (-not [string]::IsNullOrWhiteSpace($status.StdOut)) {
+    Write-Log 'WARN' 'Working tree is NOT clean:'
+    $status.StdOut -split "`r?`n" | Where-Object { $_ } | ForEach-Object { Write-Log 'WARN' ("  {0}" -f $_) }
+    Stop-Dispatcher 'Main clone working tree must be clean before the dispatcher runs.'
+}
+Write-Log 'OK' 'git: working tree is clean'
+
+# ---------------------------------------------------------------------------
+# Preflight 6: model availability (exact-answer ping). On failure the
+# dispatcher stops WITHOUT touching any Issue state (acceptance criterion 4).
+# ---------------------------------------------------------------------------
+if ($SkipModelPing) {
+    Write-Log 'WARN' 'Model ping SKIPPED by -SkipModelPing switch. Model availability is NOT verified.'
+}
+else {
+    Write-Log 'INFO' ("Pinging model {0} (timeout {1}s)..." -f $cfg.Model, $cfg.ModelPingTimeoutSec)
+    $pingPrompt = 'Reply with exactly the single word: PONG'
+    $ping = Invoke-Native -Tool 'opencode' -ArgumentList @('run', '--model', $cfg.Model, $pingPrompt) -TimeoutSec ([int]$cfg.ModelPingTimeoutSec)
+    if ($ping.TimedOut) {
+        Stop-Dispatcher ('Model ping TIMED OUT after {0}s (process tree killed). Task state untouched.' -f $cfg.ModelPingTimeoutSec)
+    }
+    if ($ping.ExitCode -ne 0) {
+        Stop-Dispatcher ('Model ping FAILED (exit {0}): {1}. Task state untouched.' -f $ping.ExitCode, $ping.StdErr.Trim())
+    }
+    if (-not (Test-PongResponse -Output $ping.StdOut)) {
+        $normalized = ($ping.StdOut -split "`r?`n" | ForEach-Object { $_.Trim() } | Where-Object { $_ }) -join ' | '
+        if ($normalized.Length -gt 200) { $normalized = $normalized.Substring(0, 200) + '...' }
+        Stop-Dispatcher ("Model ping returned unexpected answer (normalized: '{0}'). Task state untouched." -f $normalized)
+    }
+    Write-Log 'OK' 'Model ping succeeded (exact answer PONG).'
+}
+
+# ---------------------------------------------------------------------------
+# Discovery: open Issues with the ready label (read-only)
+# ---------------------------------------------------------------------------
+$issuesRaw = Invoke-Native -Tool 'gh' -ArgumentList @(
+    'issue', 'list', '--repo', $cfg.GitHubRepo,
+    '--state', 'open', '--label', $cfg.LabelReady,
+    '--json', 'number,title,url,labels', '--limit', '50'
+)
+if ($issuesRaw.ExitCode -ne 0) { Stop-Dispatcher ('gh issue list failed: {0}' -f $issuesRaw.StdErr.Trim()) }
+
+$issues = @()
+if (-not [string]::IsNullOrWhiteSpace($issuesRaw.StdOut)) {
+    try {
+        # PS 5.1 quirk: ConvertFrom-Json returns a JSON array as ONE Object[]
+        # element; pipe through ForEach-Object to flatten into a real array.
+        $issues = @(($issuesRaw.StdOut | ConvertFrom-Json) | ForEach-Object { $_ })
+    }
+    catch { Stop-Dispatcher ('gh returned invalid JSON: {0}' -f $_.Exception.Message) }
+}
+
+# Client-side filter: never touch issues that also carry in-progress
+$candidates = @()
+foreach ($issue in $issues) {
+    $labelNames = @($issue.labels | ForEach-Object { $_.name })
+    if ($labelNames -contains $cfg.LabelInProgress) {
+        Write-Log 'WARN' ("Issue #{0} has '{1}' label - skipped (already being processed)." -f $issue.number, $cfg.LabelInProgress)
+        continue
+    }
+    $candidates += , $issue
+}
+
+Write-Log 'INFO' ("Found {0} candidate Issue(s) with label '{1}'." -f $candidates.Count, $cfg.LabelReady)
+
+# Stage 1 limit: at most one task per run (preview only)
+$planned = @()
+if ($candidates.Count -gt 0) {
+    $planned = @($candidates[0])
+    if ($candidates.Count -gt 1) {
+        $rest = ($candidates | Select-Object -Skip 1 | ForEach-Object { '#{0}' -f $_.number }) -join ', '
+        Write-Log 'INFO' ("Stage 1 processes one task per run. Remaining: {0}" -f $rest)
+    }
+}
+
+# ---------------------------------------------------------------------------
+# Preview (stage 1 ends here - no claims, no branches, no sessions)
+# ---------------------------------------------------------------------------
+if ($planned.Count -eq 0) {
+    Write-Log 'INFO' 'No tasks to process. Nothing was changed.'
+    Write-Log 'INFO' '=== Dispatcher finished (stage 1) ==='
+    exit 0
+}
+
+foreach ($task in $planned) {
+    Write-Host ''
+    Write-Host '--- PLANNED TASK (preview only; nothing was executed) ---' -ForegroundColor Cyan
+    Write-Host ("Issue:     #{0} {1}" -f $task.number, $task.title)
+    Write-Host ("URL:       {0}" -f $task.url)
+    Write-Host ("Branch:    {0}/issue-{1}" -f 'opencode', $task.number)
+    Write-Host ("Target:    {0} (default branch)" -f $defaultBranch)
+    Write-Host ("Model:     {0}{1}" -f $cfg.Model, $(if ($SkipModelPing) { ' [NOT VERIFIED - ping skipped]' } else { '' }))
+    Write-Host 'Next stages (not implemented yet):'
+    Write-Host '  2. lock file + isolated git worktree'
+    Write-Host '  3. OpenCode session with timeout and logging'
+    Write-Host '  4. result verification and label transitions'
+    Write-Host '  5. branch push, PR creation, Issue comment'
+    Write-Host '-----------------------------------------------------' -ForegroundColor Cyan
+}
+
+Write-Log 'INFO' 'Preview completed. No claims, branches, sessions, or GitHub changes were made.'
+Write-Log 'INFO' '=== Dispatcher finished (stage 1) ==='
+exit 0
diff --git a/tools/dispatcher/dispatcher.tests.ps1 b/tools/dispatcher/dispatcher.tests.ps1
new file mode 100644
index 0000000..24700f7
--- /dev/null
+++ b/tools/dispatcher/dispatcher.tests.ps1
@@ -0,0 +1,345 @@
+#requires -Version 5.1
+<#
+.SYNOPSIS
+    Stage 1 test harness for dispatcher.ps1 (PowerShell 5.1).
+.DESCRIPTION
+    Runs intentional negative and positive scenarios against the REAL
+    dispatcher functions (extracted via AST from dispatcher.ps1) and the
+    real script as a child process. All temp state lives outside the
+    repository; the harness verifies GitHub state is unchanged at the end.
+    Usage: powershell -NoProfile -ExecutionPolicy Bypass -File dispatcher.tests.ps1
+#>
+[CmdletBinding()]
+param()
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+$DispatcherPath = Join-Path $PSScriptRoot 'dispatcher.ps1'
+if (-not (Test-Path -LiteralPath $DispatcherPath)) { Write-Host "FAIL: dispatcher.ps1 not found next to tests"; exit 1 }
+
+$script:Results = @()
+function Test-Case {
+    param([string]$Name, [bool]$Passed, [string]$Detail = '')
+    $script:Results += [pscustomobject]@{ Name = $Name; Passed = $Passed; Detail = $Detail }
+    $color = if ($Passed) { 'Green' } else { 'Red' }
+    $mark = if ($Passed) { 'PASS' } else { 'FAIL' }
+    Write-Host ("{0}  {1}  {2}" -f $mark, $Name, $Detail) -ForegroundColor $color
+}
+
+# --- extract functions from dispatcher.ps1 (test the real code) -----------
+$ast = [System.Management.Automation.Language.Parser]::ParseFile($DispatcherPath, [ref]$null, [ref]$null)
+$fnAsts = @($ast.FindAll({ param($n) $n -is [System.Management.Automation.Language.FunctionDefinitionAst] }, $true))
+foreach ($fnName in @('ConvertTo-WinArg', 'ConvertTo-WinCmdArg', 'Resolve-Command', 'Invoke-Native', 'Test-PongResponse', 'Test-PathInside')) {
+    $match = @($fnAsts | Where-Object { $_.Name -eq $fnName })
+    if ($match.Count -eq 0) { Write-Host ("FAIL: function {0} not found in dispatcher.ps1" -f $fnName); exit 1 }
+    Invoke-Expression $match[0].Extent.Text
+}
+
+# --- temp workspace (outside the repository) ------------------------------
+$testRoot = Join-Path ([IO.Path]::GetTempPath()) ('lyserver-dispatcher-tests-' + [guid]::NewGuid().ToString('N').Substring(0, 8))
+New-Item -ItemType Directory -Path $testRoot -Force | Out-Null
+
+$repoPath = "$HOME\Documents\LyServer"
+
+# === T0: the harness refuses to run against a dirty repository ============
+#     (Two earlier runs produced false FAILs when the harness itself was
+#      launched with uncommitted changes; commit or stash first.)
+$preStatus = & git -C $repoPath status --porcelain | Out-String
+if (-not [string]::IsNullOrWhiteSpace($preStatus)) {
+    Write-Host 'FAIL T0: repository working tree is NOT clean. Commit or stash first:' -ForegroundColor Red
+    Write-Host $preStatus -ForegroundColor Red
+    exit 1
+}
+Test-Case 'T0 repository tree clean before the suite' $true 'precondition enforced'
+
+# === Snapshot of GitHub state BEFORE the suite (used by T10) ==============
+$prsBefore = (& gh pr list -R shatVM/LyServer --state all --json number,title,url | Out-String)
+$issuesBefore = (& gh issue list -R shatVM/LyServer --state open --json number,title,labels | Out-String)
+
+function New-TestConfig {
+    # Builds a valid config psd1 in $testRoot, with optional overrides.
+    param([hashtable]$Overrides = @{})
+    $cfg = @{
+        RepoPath            = $repoPath
+        GitHubRepo          = 'shatVM/LyServer'
+        ExpectedRemote      = 'https://github.com/shatVM/LyServer.git'
+        Model               = 'opencode/mimo-v2.6-flash-free'
+        ModelPingTimeoutSec = 120
+        TaskTimeoutSec      = 1800
+        LabelReady          = 'ready-for-opencode'
+        LabelInProgress     = 'in-progress'
+        LabelReview         = 'opencode-review'
+        LogDir              = (Join-Path $testRoot 'logs')
+        RunRootDir          = (Join-Path $testRoot 'runs')
+        LockDir             = (Join-Path $testRoot 'locks')
+    }
+    foreach ($k in $Overrides.Keys) { $cfg[$k] = $Overrides[$k] }
+    $path = Join-Path $testRoot ('cfg-{0}.psd1' -f [guid]::NewGuid().ToString('N').Substring(0, 6))
+    $lines = @('@{')
+    foreach ($k in $cfg.Keys) { $lines += ("    {0} = '{1}'" -f $k, $cfg[$k]) }
+    $lines += '}'
+    Set-Content -LiteralPath $path -Value ($lines -join "`r`n") -Encoding UTF8
+    return $path
+}
+
+function Invoke-Dispatcher {
+    param([string]$ConfigPath, [switch]$SkipModelPing)
+    $argList = @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', $DispatcherPath)
+    if ($ConfigPath) { $argList += @('-ConfigPath', $ConfigPath) }
+    if ($SkipModelPing) { $argList += '-SkipModelPing' }
+    $out = & powershell.exe @argList 2>&1 | ForEach-Object { "$_" }
+    return [pscustomobject]@{ ExitCode = $LASTEXITCODE; Output = ($out -join "`n") }
+}
+
+Write-Host ''
+Write-Host ('Test workspace: {0}' -f $testRoot) -ForegroundColor Cyan
+Write-Host ''
+
+# === T1: argument quoting round-trip through a REAL child process:
+#         powershell.exe -File echo-args.ps1 writes received $args to a file;
+#         we compare what the child actually received, not the string builder
+$echoScript = Join-Path $testRoot 'echo-args.ps1'
+Set-Content -LiteralPath $echoScript -Encoding UTF8 -Value @'
+param([string]$OutFile)
+[System.IO.File]::WriteAllLines($OutFile, $args, (New-Object System.Text.UTF8Encoding($false)))
+'@
+# T1 covers the empty argument: it must round-trip as an empty string,
+# not get lost when the command line is assembled.
+$expectedArgs = @('plain', '', 'with space', 'quo"te', 'trail\', 'back\slash', 'mix \"quoted\" tail', 'Кирилиця перевірка', 'tab	value')
+$outFile = Join-Path $testRoot 'args-out.txt'
+$run = Invoke-Native -Tool 'powershell.exe' -ArgumentList (@('-NoProfile', '-File', $echoScript, $outFile) + $expectedArgs)
+$actualArgs = if (Test-Path $outFile) { @([IO.File]::ReadAllLines($outFile)) } else { @() }
+$t1ok = ($run.ExitCode -eq 0) -and ($actualArgs.Count -eq $expectedArgs.Count)
+if ($t1ok) {
+    for ($i = 0; $i -lt $expectedArgs.Count; $i++) { if ($actualArgs[$i] -cne $expectedArgs[$i]) { $t1ok = $false; break } }
+}
+Test-Case 'T1 quoting round-trip (empty/space/quotes/backslash/Cyrillic/tab)' $t1ok ("received {0}/{1} args" -f $actualArgs.Count, $expectedArgs.Count)
+
+# === T2: PONG answer exactness (unit on the real function)
+$pongCases = @(
+    @{ In = "PONG`n";                   Expect = $true;  Label = 'exact single line' }
+    @{ In = "  PONG  `r`n";             Expect = $true;  Label = 'trimmed whitespace' }
+    @{ In = "NOT PONG`n";               Expect = $false; Label = 'NOT PONG rejected' }
+    @{ In = "pong`n";                   Expect = $false; Label = 'lowercase rejected' }
+    @{ In = "PONG`nextra text`n";       Expect = $false; Label = 'multi-line blob rejected' }
+    # PS 5.1 has no `e escape; build ESC via [char]27
+    @{ In = ([char]27 + '[32mPONG' + [char]27 + '[0m' + "`n"); Expect = $true;  Label = 'ANSI-wrapped accepted' }
+    @{ In = '';                          Expect = $false; Label = 'empty rejected' }
+    @{ In = "`n`n";                      Expect = $false; Label = 'blank-only rejected' }
+)
+$pongOk = $true
+foreach ($c in $pongCases) {
+    $got = Test-PongResponse -Output $c.In
+    if ($got -ne $c.Expect) { $pongOk = $false; Write-Host ("    PONG case '{0}': expected {1}, got {2}" -f $c.Label, $c.Expect, $got) -ForegroundColor Yellow }
+}
+Test-Case 'T2 PONG exact-answer check (8 cases)' $pongOk 'NOT PONG/pong/multi-line rejected'
+
+# === T3: Resolve-Command for a missing tool returns $null
+$nullResolved = Resolve-Command -Name 'definitely-not-a-tool-xyz'
+Test-Case 'T3 Resolve-Command returns null for missing tool' ($null -eq $nullResolved) ''
+
+# === T4: missing config file
+$run = Invoke-Dispatcher -ConfigPath (Join-Path $testRoot 'no-such-config.psd1')
+Test-Case 'T4 missing config -> safe stop' ($run.ExitCode -eq 1 -and $run.Output -match 'config not found') ("exit {0}" -f $run.ExitCode)
+
+# === T5: invalid configs (missing key / negative timeout / LogDir inside repo)
+$bad1 = New-TestConfig -Overrides @{ Model = '' }
+$run = Invoke-Dispatcher -ConfigPath $bad1
+Test-Case 'T5a empty required key rejected' ($run.ExitCode -eq 1 -and $run.Output -match 'missing or empty required key: Model') ("exit {0}" -f $run.ExitCode)
+
+$bad2 = New-TestConfig -Overrides @{ ModelPingTimeoutSec = '-5' }
+$run = Invoke-Dispatcher -ConfigPath $bad2
+Test-Case 'T5b negative timeout rejected' ($run.ExitCode -eq 1 -and $run.Output -match 'positive integer') ("exit {0}" -f $run.ExitCode)
+
+$bad3 = New-TestConfig -Overrides @{ LogDir = (Join-Path $repoPath 'logs-inside-repo') }
+$run = Invoke-Dispatcher -ConfigPath $bad3
+Test-Case 'T5c LogDir inside repository rejected' ($run.ExitCode -eq 1 -and $run.Output -match 'must be OUTSIDE the repository') ("exit {0}" -f $run.ExitCode)
+
+# === T6: dirty working tree -> stop BEFORE the model ping (order check)
+$dirtyProbe = Join-Path $repoPath 'zz-dirty-probe.tmp'
+Set-Content -LiteralPath $dirtyProbe -Value 'test' -Encoding UTF8
+try {
+    $cfgDirty = New-TestConfig   # valid config; own LogDir in temp
+    $run = Invoke-Dispatcher -ConfigPath $cfgDirty
+    $logFile = @()
+    $dirtyLogDir = Join-Path $testRoot 'logs'
+    if (Test-Path $dirtyLogDir) { $logFile = @(Get-ChildItem $dirtyLogDir -Filter '*.log' | Sort-Object LastWriteTime | Select-Object -Last 1) }
+    $logText = if ($logFile.Count -gt 0) { [IO.File]::ReadAllText($logFile[0].FullName) } else { '' }
+    $stopped = ($run.ExitCode -eq 1 -and $run.Output -match 'must be clean')
+    $noPing = ($logText -notmatch 'Pinging model')
+    Test-Case 'T6a dirty tree -> safe stop' $stopped ("exit {0}" -f $run.ExitCode)
+    Test-Case 'T6b dirty tree -> NO model ping happened (order)' $noPing 'checked log of this run'
+}
+finally {
+    Remove-Item -LiteralPath $dirtyProbe -Force -ErrorAction SilentlyContinue
+}
+
+# === T7: model timeout -> safe stop (kills process tree)
+$cfgTimeout = New-TestConfig -Overrides @{ ModelPingTimeoutSec = '1' }
+$run = Invoke-Dispatcher -ConfigPath $cfgTimeout
+Test-Case 'T7 model ping timeout -> safe stop' ($run.ExitCode -eq 1 -and $run.Output -match 'TIMED OUT') ("exit {0}" -f $run.ExitCode)
+
+# === T8: unavailable model -> safe stop (not treated as success)
+$cfgBadModel = New-TestConfig -Overrides @{ Model = 'opencode/nonexistent-model-xyz' }
+$run = Invoke-Dispatcher -ConfigPath $cfgBadModel
+Test-Case 'T8 unavailable model -> safe stop' ($run.ExitCode -eq 1 -and $run.Output -match 'FAILED') ("exit {0}" -f $run.ExitCode)
+
+# === T9: full preview run (real model ping) succeeds
+$cfgOk = New-TestConfig
+$run = Invoke-Dispatcher -ConfigPath $cfgOk
+Test-Case 'T9 full preview run -> exit 0' ($run.ExitCode -eq 0 -and $run.Output -match 'Preview completed') ("exit {0}" -f $run.ExitCode)
+
+# === T10: GitHub state unchanged by the whole suite.
+#     Full lists captured BEFORE the suite (top of this file) are compared
+#     with the current state - not just spot checks on issue numbers.
+$issuesAfter = (& gh issue list -R shatVM/LyServer --state open --json number,title,labels | Out-String)
+$prsAfter = (& gh pr list -R shatVM/LyServer --state all --json number,title,url | Out-String)
+$issuesNow = @(($issuesAfter | ConvertFrom-Json) | ForEach-Object { $_ })
+function Get-LabelNames($issue) { return @($issue.labels | ForEach-Object { $_.name }) }
+$issue3 = @($issuesNow | Where-Object { $_.number -eq 3 })
+$issue2 = @($issuesNow | Where-Object { $_.number -eq 2 })
+$labelsSanity = ($issue3.Count -eq 1 -and (Get-LabelNames $issue3[0]) -contains 'in-progress' -and
+             $issue2.Count -eq 1 -and (Get-LabelNames $issue2[0]) -contains 'ready-for-opencode')
+$issuesUnchanged = ($issuesBefore -ceq $issuesAfter)
+$prsUnchanged = ($prsBefore -ceq $prsAfter)
+Test-Case 'T10a full open-issue list unchanged (before vs after)' $issuesUnchanged 'exact string comparison of JSON'
+Test-Case 'T10b full PR list unchanged (before vs after)' $prsUnchanged 'exact string comparison of JSON'
+Test-Case 'T10c label sanity: #3 in-progress, #2 ready' $labelsSanity ''
+$gitStatus = & git -C $repoPath status --porcelain | Out-String
+Test-Case 'T10d repository working tree clean' ([string]::IsNullOrWhiteSpace($gitStatus)) 'no probe/temp files left'
+
+# === T11: Test-PathInside boundary rules (unit on the real function)
+$pathCases = @(
+    @{ Child = 'C:\LyServerLogs';              Parent = 'C:\LyServer';        Expect = $false; Label = 'sibling prefix is NOT inside' }
+    @{ Child = 'C:\LyServer\logs';             Parent = 'C:\LyServer';        Expect = $true;  Label = 'true subdirectory is inside' }
+    @{ Child = 'C:\lyserver\LOGS';             Parent = 'C:\LYSERVER';        Expect = $true;  Label = 'case-insensitive match' }
+    @{ Child = 'C:\LyServer';                  Parent = 'C:\LyServer\';       Expect = $true;  Label = 'same path, trailing sep on parent' }
+    @{ Child = 'C:\LyServer\';                 Parent = 'C:\LyServer';        Expect = $true;  Label = 'same path, trailing sep on child' }
+    @{ Child = 'C:\LyServer';                  Parent = 'C:\LyServer\sub';    Expect = $false; Label = 'parent nested in child' }
+    @{ Child = 'C:\Other';                     Parent = 'C:\LyServer';        Expect = $false; Label = 'unrelated path' }
+)
+$pathOk = $true
+foreach ($c in $pathCases) {
+    $got = Test-PathInside -Child $c.Child -Parent $c.Parent
+    if ($got -ne $c.Expect) { $pathOk = $false; Write-Host ("    path case '{0}': expected {1}, got {2}" -f $c.Label, $c.Expect, $got) -ForegroundColor Yellow }
+}
+Test-Case 'T11 Test-PathInside boundaries (7 cases)' $pathOk 'sibling prefix C:\LyServerLogs excluded'
+
+# === T12: timeout kills the process TREE, spares unrelated processes,
+#           and reports the timeout instead of masking it
+$sentinel = Start-Process powershell.exe -ArgumentList @('-NoProfile', '-Command', 'Start-Sleep 300') -PassThru -WindowStyle Hidden
+$treeTarget = Join-Path $testRoot 'tree-target.ps1'
+$pidFile = Join-Path $testRoot 'grandchild.pid'
+$treeTargetBody = @'
+$gc = Start-Process powershell.exe -ArgumentList @('-NoProfile', '-Command', 'Start-Sleep 300') -PassThru -WindowStyle Hidden
+Set-Content -LiteralPath '__PIDFILE__' -Value $gc.Id
+Start-Sleep 300
+'@ -replace '__PIDFILE__', $pidFile
+Set-Content -LiteralPath $treeTarget -Value $treeTargetBody -Encoding UTF8
+try {
+    $treeRun = Invoke-Native -Tool 'powershell.exe' -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', $treeTarget) -TimeoutSec 5
+    $reportedTimeout = ($treeRun.TimedOut -eq $true)
+    $gcId = if (Test-Path $pidFile) { [int]([IO.File]::ReadAllText($pidFile).Trim()) } else { 0 }
+    $grandchildDead = $false
+    if ($gcId -gt 0) {
+        Start-Sleep -Milliseconds 500
+        try { $left = Get-Process -Id $gcId -ErrorAction Stop; $null = $left } catch { $grandchildDead = $true }
+    }
+    Test-Case 'T12a timeout reported as TimedOut (reason not masked)' $reportedTimeout ''
+    Test-Case 'T12b grandchild process killed by tree kill' ($gcId -gt 0 -and $grandchildDead) ("grandchild pid {0}" -f $gcId)
+    $sentinelAlive = $false
+    try { $s = Get-Process -Id $sentinel.Id -ErrorAction Stop; $sentinelAlive = ($s.Id -eq $sentinel.Id) } catch { }
+    Test-Case 'T12c unrelated sentinel process survives' $sentinelAlive ("sentinel pid {0}" -f $sentinel.Id)
+}
+finally {
+    try { Stop-Process -Id $sentinel.Id -Force -ErrorAction SilentlyContinue } catch { }
+    Remove-Item -LiteralPath $pidFile, $treeTarget -Force -ErrorAction SilentlyContinue
+}
+
+# === T13: full-run ORDER of stages, read from the real log of T9
+#     (T6-T9 already execute dispatcher.ps1 as a whole child process;
+#      this asserts the execution order inside that full run)
+$latestLogPath = $null
+$logDirT = Join-Path $testRoot 'logs'
+if (Test-Path $logDirT) {
+    $allLogs = @(Get-ChildItem $logDirT -Filter '*.log' | Sort-Object LastWriteTime)
+    if ($allLogs.Count -gt 0) { $latestLogPath = $allLogs[-1].FullName }
+}
+function Get-LineIndex($text, $pattern) {
+    $lines = @($text -split "`r?`n")
+    for ($i = 0; $i -lt $lines.Count; $i++) { if ($lines[$i] -match $pattern) { return $i } }
+    return -1
+}
+$logTextT = if ($latestLogPath) { [IO.File]::ReadAllText($latestLogPath) } else { '' }
+$iTree = Get-LineIndex $logTextT 'working tree is clean'
+$iPing = Get-LineIndex $logTextT 'Pinging model'
+$iPong = Get-LineIndex $logTextT 'Model ping succeeded'
+$iDisc = Get-LineIndex $logTextT 'Found \d+ candidate'
+$iPrev = Get-LineIndex $logTextT 'Preview completed'
+$orderOk = ($iTree -ge 0 -and $iPing -gt $iTree -and $iPong -gt $iPing -and $iDisc -gt $iPong -and $iPrev -gt $iDisc)
+Test-Case 'T13 full run order: tree -> ping -> pong -> discovery -> preview' $orderOk ("lines {0}<{1}<{2}<{3}<{4}" -f $iTree, $iPing, $iPong, $iDisc, $iPrev)
+
+# === T14: REAL .cmd wrapper launch through cmd.exe /d /c
+#     The wrapper mirrors real npm-style .cmd shims: it forwards %* to
+#     powershell.exe -File echo-args.ps1. This exercises cmd.exe
+#     metacharacter parsing (&, parens), path-with-space quoting,
+#     empty args and Cyrillic end-to-end. NOTE: embedded double quotes
+#     and trailing backslashes CANNOT cross the cmd.exe -> final-receiver
+#     (CommandLineToArgvW) boundary faithfully - ConvertTo-WinCmdArg
+#     refuses both; refusals are tested in T14b/T14c.
+$wrapDir = Join-Path $testRoot 'wrap dir'   # space in the path on purpose
+New-Item -ItemType Directory -Path $wrapDir -Force | Out-Null
+$wrapCmd = Join-Path $wrapDir 'fakecmd.cmd'
+Set-Content -LiteralPath $wrapCmd -Encoding ASCII -Value @"
+@echo off
+powershell.exe -NoProfile -File "$echoScript" %*
+"@
+$env:Path = "$wrapDir;$env:Path"
+$cmdOutFile = Join-Path $testRoot 'cmd-args-out.txt'
+$cmdArgs = @($cmdOutFile, 'with space', 'a&b', 'x(y)', 'mid\path', 'Кирилиця', '')
+$run = Invoke-Native -Tool 'fakecmd.cmd' -ArgumentList $cmdArgs
+$cmdActual = if (Test-Path $cmdOutFile) { @([IO.File]::ReadAllLines($cmdOutFile)) } else { @() }
+$cmdOk = ($run.ExitCode -eq 0) -and ($cmdActual.Count -eq ($cmdArgs.Count - 1))
+if ($cmdOk) {
+    $expectedTail = @($cmdArgs | Select-Object -Skip 1)
+    for ($i = 0; $i -lt $expectedTail.Count; $i++) { if ($cmdActual[$i] -cne $expectedTail[$i]) { $cmdOk = $false; break } }
+}
+Test-Case 'T14 .cmd wrapper round-trip (space/&/parens/mid-backslash/empty/Cyrillic, dir with space)' $cmdOk ("received {0}/{1} args" -f $cmdActual.Count, ($cmdArgs.Count - 1))
+
+# T14b: an argument containing a double quote must be REFUSED, not corrupted
+$t14b = $false
+try {
+    $null = Invoke-Native -Tool 'fakecmd.cmd' -ArgumentList @($cmdOutFile, 'quo"te')
+}
+catch { $t14b = ($_.Exception.Message -match 'double quote') }
+Test-Case 'T14b .cmd wrapper refuses embedded double quote (no silent corruption)' $t14b 'cmd.exe has no escaping for "'
+
+# T14c: an argument ending with a backslash must be REFUSED, not merged
+$t14c = $false
+try {
+    $null = Invoke-Native -Tool 'fakecmd.cmd' -ArgumentList @($cmdOutFile, 'trail\')
+}
+catch { $t14c = ($_.Exception.Message -match 'backslash') }
+Test-Case 'T14c .cmd wrapper refuses trailing backslash (would merge args)' $t14c 'two-layer parse boundary'
+
+# === T15: Resolve-Command handles every supported command type explicitly
+$rExe = Resolve-Command -Name 'powershell.exe'
+$rCmd = Resolve-Command -Name 'fakecmd.cmd'
+$ps1Wrap = Join-Path $wrapDir 'fakeps.ps1'
+Set-Content -LiteralPath $ps1Wrap -Encoding UTF8 -Value '"ps1-wrapper-ran"'
+$t15a = ($null -ne $rExe -and $rExe.FilePath -match 'powershell\.exe$' -and $rExe.PrefixArgs.Count -eq 0)
+$t15b = ($null -ne $rCmd -and $rCmd.FilePath -eq 'cmd.exe' -and ($rCmd.PrefixArgs -join ' ') -eq ('/d /c ' + $wrapCmd))
+$rPs1 = Resolve-Command -Name 'fakeps'
+$t15c = ($null -ne $rPs1 -and $rPs1.FilePath -eq 'powershell.exe' -and ($rPs1.PrefixArgs -contains '-File') -and ($rPs1.PrefixArgs -contains $ps1Wrap))
+Test-Case 'T15a Resolve-Command .exe type (direct, no prefix)' $t15a ''
+Test-Case 'T15b Resolve-Command .cmd type (cmd.exe /d /c)' $t15b ''
+Test-Case 'T15c Resolve-Command .ps1 type (powershell -File)' $t15c ''
+
+# --- summary --------------------------------------------------------------
+$failed = @($script:Results | Where-Object { -not $_.Passed })
+Write-Host ''
+Write-Host ('Total: {0}, passed: {1}, failed: {2}' -f $script:Results.Count, ($script:Results.Count - $failed.Count), $failed.Count) -ForegroundColor $(if ($failed.Count -eq 0) { 'Green' } else { 'Red' })
+Write-Host ('Temp workspace kept for inspection: {0}' -f $testRoot) -ForegroundColor Cyan
+if ($failed.Count -gt 0) { exit 1 }
+exit 0
